{
  "schema": "axiom.jurisdictions.v1",
  "description": "Canonical registry of the 50 US states and the District of Columbia: USPS code, Census FIPS code, NBER TAXSIM (SOI) state code, name, rulespec-us jurisdiction slug, and personal income tax base, plus TAXSIM's special state codes. Every field is tested against the source recorded for it under sources; consumers read this file (or a copy pinned by sha256) instead of typing their own state tables.",
  "sources": {
    "census_fips": {
      "fields": [
        "usps",
        "fips",
        "name"
      ],
      "title": "Census Bureau state FIPS codes (state.txt)",
      "url": "https://www2.census.gov/geo/docs/reference/state.txt",
      "retrieved": "2026-09-24",
      "sha256": "bea4e03f71a1fa0045ae732aabad11fa541e5932b071c2369bb0d325e8cba5a0",
      "fixture": "tests/fixtures/jurisdictions/census_state.txt",
      "note": "Rows with FIPS 01-56 (50 states and DC); territories are out of scope."
    },
    "taxsim": {
      "fields": [
        "taxsim_soi",
        "taxsim_name",
        "taxsim"
      ],
      "title": "NBER TAXSIM taxsimtest state echo (idtl=5) and idtl=0 probes",
      "binary": "resources/taxsimtest/taxsimtest-osx.exe in PolicyEngine/policyengine-taxsim",
      "binary_sha256": "4a17af9c2adbea27b1e6cce240610aede264e008bcdf64b131e0c81220f62b8c",
      "build": "cd2026081819",
      "probe": "printf 'taxsimid,year,state,mstat,pwages,idtl\\n1,2024,<code>,1,50000,5\\n' | taxsimtest-osx.exe",
      "fixture": "tests/fixtures/jurisdictions/taxsim_state_code_probes.json"
    },
    "rulespec_slug": {
      "fields": [
        "rulespec_slug"
      ],
      "title": "rulespec-us jurisdiction root directories",
      "repository": "TheAxiomFoundation/rulespec-us",
      "commit": "dcb2e47e0af964be6d59f80688f519d0a6a96a71",
      "path": ".axiom/repository-structure.yaml",
      "fixture": "tests/fixtures/jurisdictions/rulespec_us_root_directories.json"
    },
    "personal_income_tax_base": {
      "fields": [
        "personal_income_tax_base",
        "has_broad_personal_income_tax"
      ],
      "title": "State Individual Income Tax Rates and Brackets, 2026",
      "publisher": "Tax Foundation",
      "url": "https://taxfoundation.org/data/all/state/state-income-tax-rates-2026/",
      "as_of": "2026-01-01",
      "retrieved": "2026-09-24",
      "fixture": "tests/fixtures/jurisdictions/income_tax_base_2026.json",
      "note": "wages_and_salaries: the state taxes wage and salary income (has_broad_personal_income_tax true). capital_gains_only: the state taxes capital gains income only. none: no individual income tax."
    }
  },
  "taxsim": {
    "missing_state_column_code": 0,
    "invalid_state_code_behavior": "TAXSIM stops the run with '<code> is not a valid SOI state code'.",
    "special_state_codes": [
      {
        "code": 0,
        "key": "no_state",
        "idtl5_label": "State not specified",
        "meaning": "No state income tax is computed; the output state column echoes 0. A missing state column is read as 0."
      },
      {
        "code": -1,
        "key": "all_states",
        "idtl5_label": "State not specified",
        "meaning": "TAXSIM computes the record once for every state code 1-51 and returns one output row per state."
      }
    ]
  },
